NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by the app.
# Neon: copy the pooled connection string from the dashboard and change
# sslmode=require to sslmode=verify-full (same checks, no pg deprecation warning).
# Local: postgresql://postgres:postgres@localhost:5432/rootover?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) connection used by the Prisma CLI for migrations.
# Neon: the same URL without "-pooler" in the host. Leave empty for local Postgres.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Allowed CORS origin for the browser client (https in production)
FRONTEND_URL=http://localhost:3000

# Demo conveniences: one-click demo logins and coupon hints in the frontend,
# "Fill demo data" on the teacher application. true for local demos only; the
# server refuses to start with it in production.
DEMO_MODE=false

# Number of proxies in front of the server: 0 locally, 1 behind Render, Railway,
# Fly, Heroku or nginx. Without it every visitor shares one rate-limit bucket.
TRUST_PROXY=0

# Access tokens (passport-jwt). Rotating the secret signs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Cloudinary: Dashboard → Settings → API Keys mundevgmail

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_FOLDER=rootover

# Outgoing email (sign-up verification codes, password reset codes) via Resend:
# resend.com → API Keys → create a key with "Sending access". EMAIL_FROM must use
# a domain verified in Resend (onboarding@resend.dev only delivers to your own
# Resend account address). Leave RESEND_API_KEY empty in development to print
# emails to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Root Over Education <no-reply@rootover.local>"

# ---------------------------------------------------------------- payments
# Public base URL of this API, without a trailing slash. bKash sends the payer's
# browser back to <API_PUBLIC_URL>/api/payments/bkash/callback, so it must be
# reachable from the payer's browser.
#   Local sandbox testing: http://localhost:5000
#   Production (https required): https://api.rootover.site
#     (or https://<service>.onrender.com until the custom domain is verified)
API_PUBLIC_URL=http://localhost:5000

# Provider. With the four BKASH_* credentials set the provider is bkash; without
# them payments are simulated (development only: refused in production).
# PAYMENT_PROVIDER=bkash|simulated forces one (tests always use simulated).
# PAYMENT_PROVIDER=

# bKash Tokenized Checkout base URL. Keep exactly one; any other value is warned
# about at startup.
#   Sandbox (test payments, no money moves; allowed in production with a
#   warning, for testing a deployment):
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
#   Live (real money):
# BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

# Merchant credentials from bKash. Sandbox and live credentials are different:
# sandbox ones only work with the sandbox URL, live ones only with the live URL.
# Change the URL and all four values together. Never commit or log them.
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
